# Copy to .env and adjust. Never commit .env.
# The application runs with SQLite and sane dev defaults when this file is absent.

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local dev default (leave commented to use SQLite):
# DATABASE_URL=postgres://crm:crm@127.0.0.1:5432/uchebniycrm

DJANGO_TIME_ZONE=Asia/Tashkent
