# ─────────────────────────────────────────────────────────────────────────────
# Learning Centre CRM — environment template
#
# Copy to .env for local development:   cp .env.example .env
# NEVER commit .env — it is gitignored.
#
# With no .env at all the application runs on SQLite with DEBUG on and the
# frontend dev server, which is enough for `make run`. The variables below
# matter as soon as you move beyond that.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
# true  = development (SQLite fallback allowed, insecure defaults permitted)
# false = production  (SECRET_KEY and ALLOWED_HOSTS become REQUIRED; startup
#                       fails with a clear error if they are missing)
DJANGO_DEBUG=true

# REQUIRED when DJANGO_DEBUG=false. Minimum 50 random characters.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=dev-only-insecure-secret-key

# Comma-separated hostnames the application is served from.
# REQUIRED to change from the dev default when DJANGO_DEBUG=false.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated scheme://host origins trusted for CSRF (needed behind a proxy
# or when the app is served from a real domain, e.g. https://crm.example.uz).
DJANGO_CSRF_TRUSTED_ORIGINS=

# IANA timezone. Default: Asia/Tashkent
DJANGO_TIME_ZONE=Asia/Tashkent

# ── Database ─────────────────────────────────────────────────────────────────
# Leave unset to use SQLite at backend/db.sqlite3 (development and tests).
# Set to a PostgreSQL URL to use PostgreSQL (required in production).
# DATABASE_URL=postgres://crm:CHANGE_ME@127.0.0.1:5432/uchebniycrm

# Used by docker-compose to build the db service and the web DATABASE_URL.
# REQUIRED for `docker compose up` — there is no default.
# POSTGRES_DB=uchebniycrm
# POSTGRES_USER=crm
# POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD


# ── TLS termination (opt-in, production behind a reverse proxy) ──────────────
# Set DJANGO_SECURE_PROXY=true once your proxy sends X-Forwarded-Proto: https.
# Enables SECURE_SSL_REDIRECT, HSTS (1 year), secure cookies and the proxy header.
# DJANGO_SECURE_PROXY=false
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_HSTS_SECONDS=31536000

# ── Storage paths (optional) ─────────────────────────────────────────────────
# Where collected static files and user uploads live. Defaults to the repository
# root (repo/staticfiles, repo/media), which is what local development, the test
# suite and the Docker image use, so you normally leave these unset.
#
# Set them when the backend is deployed as an isolated service whose working
# directory is backend/, which cannot write to the repository root. A relative
# value is resolved against backend/; an absolute value is used as given.
# DJANGO_STATIC_ROOT=staticfiles
# DJANGO_MEDIA_ROOT=media
# Directory holding the built SPA (index.html + assets/). The API runs without
# it - only the SPA route needs it - so this is only for deployments that build
# the frontend in a separate service.
# DJANGO_FRONTEND_DIST=../frontend/dist

# ── Docker port mapping (optional) ───────────────────────────────────────────
# WEB_PORT=8000
